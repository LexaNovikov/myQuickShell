#!/usr/bin/env bash

set -eu

runtime_dir="${XDG_RUNTIME_DIR:-/tmp/quickshell-greeter-$(id -u)}"
install -d -m 700 "$runtime_dir"

export XDG_RUNTIME_DIR="$runtime_dir"
export QS_DISABLE_FILE_WATCHER=1
unset WAYLAND_DISPLAY DISPLAY

if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- cage -d -s -m last -- \
        qs --path /etc/greetd/quickshell-greeter --no-duplicate
fi

exec cage -d -s -m last -- \
    qs --path /etc/greetd/quickshell-greeter --no-duplicate
